# Copy to .env and change the secrets. Both the backend and docker-compose read this file.

# --- backend ---
DATABASE_URL=postgresql+psycopg://adforge:adforge@localhost:5432/adforge
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-characters
ADMIN_EMAIL=admin@adforge.local
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
# Where uploaded images live (local disk). Mounted as a volume in docker-compose.
STORAGE_BACKEND=local
STORAGE_PATH=../storage
# Used to build image URLs in runtime responses. Set to the public address of the backend when behind a proxy.
PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_RUNTIME_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=10
RUNTIME_TTL_SECONDS=60
# Apps connect with their application ID alone. Set to true to also require each app's runtime key.
RUNTIME_REQUIRE_KEY=false
# How long a running app's request may wait on the server for a change (a stop, a new ad).
RUNTIME_LONG_POLL_SECONDS=25
# An app that can't reach AdForge for this long stops showing ads until it can (seconds).
RUNTIME_MAX_STALE_SECONDS=21600
# Largest project zip accepted for scanning (bytes).
MAX_SCAN_BYTES=314572800
# AdForge's app files, added to apps by "Download app ready for ads". Defaults to flutter_demo/lib/adforge in this repo.
# ADFORGE_SDK_PATH=

# --- dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker-compose database ---
POSTGRES_USER=adforge
POSTGRES_PASSWORD=adforge
POSTGRES_DB=adforge
